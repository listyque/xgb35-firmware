#!/bin/busybox sh
export PATH=/bin HOME=/root SHELL=/bin/sh TERM=vt100
export PS1='diagnostic# '

/bin/busybox --install -s /bin
mount -t proc proc /proc || echo 'WARNING: proc mount failed'
mount -t sysfs sysfs /sys || echo 'WARNING: sysfs mount failed'
if ! mount -t devtmpfs devtmpfs /dev; then
    echo 'WARNING: devtmpfs unavailable; creating device nodes with mdev'
    mdev -s
fi
mkdir -p /dev/pts
mount -t devpts devpts /dev/pts || echo 'WARNING: devpts unavailable'
exec </dev/console >/dev/console 2>&1

echo
echo 'ATM7051H diagnostic Linux -- experimental, running from RAM'
echo 'No NAND modules, storage mounts or updater started by this init.'
echo 'Commands: diagnose, dmesg, cat /proc/meminfo, ls /sys'
echo 'After collecting the log, switch the console off.'
echo
diagnose

# PID 1 must survive the user exiting the diagnostic shell.
while true; do
    setsid cttyhack /bin/sh
    echo 'Shell exited; reopening in one second.'
    sleep 1
done
