+#if defined(PVR_ATS3605)
+/* ARMv7 MVA operations from Linux arch/arm/mm/cache-v7.S. */
+enum pvr_cache_op {
+	PVR_CACHE_CLEAN,
+	PVR_CACHE_INVALIDATE,
+	PVR_CACHE_FLUSH,
+};
+
+static inline void pvr_dmac_range(const void *start, const void *end,
+				  enum pvr_cache_op op)
+{
+	unsigned long first = (unsigned long)start;
+	unsigned long last = (unsigned long)end;
+	unsigned long ctr, size, line;
+
+	if (first >= last)
+		return;
+	asm volatile("mrc p15, 0, %0, c0, c0, 1" : "=r"(ctr));
+	size = 4UL << ((ctr >> 16) & 15);
+	line = first & ~(size - 1);
+	for (;;) {
+		if (op == PVR_CACHE_CLEAN)
+			asm volatile("mcr p15, 0, %0, c7, c10, 1" : : "r"(line) : "memory");
+		else if (op == PVR_CACHE_FLUSH || line < first || last - line < size)
+			asm volatile("mcr p15, 0, %0, c7, c14, 1" : : "r"(line) : "memory");
+		else
+			asm volatile("mcr p15, 0, %0, c7, c6, 1" : : "r"(line) : "memory");
+		if (last - line <= size)
+			break;
+		line += size;
+	}
+	dsb();
+}
+
+static void pvr_dmac_flush_range(const void *start, const void *end)
+{
+	pvr_dmac_range(start, end, PVR_CACHE_FLUSH);
+}
+
+static void pvr_dmac_inv_range(const void *start, const void *end)
+{
+	pvr_dmac_range(start, end, PVR_CACHE_INVALIDATE);
+}
+
+static void pvr_dmac_clean_range(const void *start, const void *end)
+{
+	pvr_dmac_range(start, end, PVR_CACHE_CLEAN);
+}
+#else
+#define pvr_dmac_flush_range dmac_flush_range
