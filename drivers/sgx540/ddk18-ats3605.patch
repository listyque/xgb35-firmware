+	u32 frequency = UINT_MAX;
+	u32 voltage = 0;
+	int length, ret;
+	unsigned int i;
+
+	if (gpu_mhz != 120 && gpu_mhz != 360)
+		return -ERANGE;
+	max_rate = gpu_mhz * (unsigned long)ONE_MHZ;
+	for (i = 1; i < ARRAY_SIZE(ats3605_clocks); ++i) {
+		unsigned long rate = clk_get_rate(ats3605_clocks[i]);
+		if (!rate)
+			return -EINVAL;
+		saved_rates[i] = rate;
+		saved_parents[i] = clk_get_parent(ats3605_clocks[i]);
+		max_rate = max(max_rate, rate);
+	}
+
+	/* Cover both the requested rate and the rates restored on suspend. */
+	node = of_find_compatible_node(NULL, NULL, "actions,ats3605-gpu");
+	if (!node)
+		return -EINVAL;
+
+	opps = of_get_property(node, "operating-points", &length);
+	if (opps && length % (2 * sizeof(*opps)) == 0) {
+		for (i = 0; i < length / sizeof(*opps); i += 2) {
+			u32 khz = be32_to_cpu(opps[i]);
+			if (khz >= DIV_ROUND_UP(max_rate, 1000) && khz < frequency) {
+				frequency = khz;
+				voltage = be32_to_cpu(opps[i + 1]);
+			}
+		}
+	}
+	of_node_put(node);
+	if (!voltage || voltage > INT_MAX)
+		return -EINVAL;
+
+	ret = regulator_set_voltage(ats3605_supply, voltage, INT_MAX);
+	if (ret)
+		return ret;
+	ret = regulator_enable(ats3605_supply);
+	if (ret)
+		return ret;
+	ret = pm_runtime_get_sync(dev);
+	if (ret < 0) {
+		pm_runtime_put_noidle(dev);
+		goto disable_supply;
+	}
+	/* DEVPLL's firmware rate can disagree with CCF. Only change GPU dividers. */
+	ddr = clk_get_sys(NULL, "ddr_pll");
+	if (IS_ERR(ddr)) {
+		ret = PTR_ERR(ddr);
+		goto disable_power;
+	}
+	if (clk_get_rate(ddr) != 720 * ONE_MHZ) {
+		clk_put(ddr);
+		ret = -ERANGE;
+		goto disable_power;
+	}
+	for (i = 1; i < ARRAY_SIZE(ats3605_clocks); ++i) {
+		ret = clk_set_parent(ats3605_clocks[i], ddr);
+		if (!ret)
+			ret = clk_set_rate(ats3605_clocks[i], gpu_mhz * ONE_MHZ);
+		if (ret || clk_get_rate(ats3605_clocks[i]) != gpu_mhz * ONE_MHZ) {
+			ATS3605RestoreRates(dev, i);
+			clk_put(ddr);
+			if (!ret)
+				ret = -ERANGE;
+			goto disable_power;
+		}
+	}
+	clk_put(ddr);
+	for (i = 0; i < ARRAY_SIZE(ats3605_clocks); ++i) {
+		ret = clk_prepare_enable(ats3605_clocks[i]);
+		if (ret)
+			goto disable_clocks;
+	}
+	dev_info(dev, "ATS3605 GPU clocks %lu/%lu/%lu Hz at %u uV\n",
+		 clk_get_rate(ats3605_clocks[1]), clk_get_rate(ats3605_clocks[2]),
+		 clk_get_rate(ats3605_clocks[3]), voltage);
+	return 0;
+
+disable_clocks:
+	while (i > 0)
+		clk_disable_unprepare(ats3605_clocks[--i]);
+	ATS3605RestoreRates(dev, ARRAY_SIZE(ats3605_clocks) - 1);
+disable_power:
+	pm_runtime_put_sync(dev);
+disable_supply:
+	regulator_disable(ats3605_supply);
+	return ret;
+}
+
+static void ATS3605DisableClocks(struct device *dev)
+{
+	int i, ret;
+
+	for (i = ARRAY_SIZE(ats3605_clocks); i > 0; --i)
+		clk_disable_unprepare(ats3605_clocks[i - 1]);
+	ATS3605RestoreRates(dev, ARRAY_SIZE(ats3605_clocks) - 1);
+	ret = pm_runtime_put_sync(dev);
+	if (ret < 0)
+		dev_warn(dev, "GPU runtime suspend failed: %d\n", ret);
+	ret = regulator_disable(ats3605_supply);
+	if (ret)
+		dev_warn(dev, "GPU regulator disable failed: %d\n", ret);
+}
